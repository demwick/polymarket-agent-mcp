# Polymarket CLOB API (Required for Live mode, optional for Preview)
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_FUNDER_ADDRESS=

# Bot settings
DAILY_BUDGET=20
MIN_CONVICTION=3
COPY_MODE=preview

# Optional 404.directory risk preflight for live binary orders.
# Disabled by default. "shadow" never blocks or changes order execution.
DIRECTORY_404_RISK_MODE=off
DIRECTORY_404_EXECUTION_MODE=unattended
DIRECTORY_404_GEOGRAPHIC_ELIGIBILITY=unknown

# Optional
CHAIN_ID=137
